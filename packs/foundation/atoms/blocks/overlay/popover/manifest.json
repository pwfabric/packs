{
  "id": "overlay.popover",
  "kind": "block",
  "version": "1.1.0",
  "category": "overlay",
  "name": "popover",
  "state": "stable",
  "knowledge": {
    "purpose": "Trigger button that reveals a small floating panel of contextual content on click",
    "useCases": [
      "Help or info bubble next to a field",
      "Compact filter or options menu off a button",
      "Contextual details preview without leaving the page"
    ],
    "composesWith": [
      "control.button",
      "container.card",
      "control.badge",
      "text.text"
    ],
    "antiPatterns": [
      "Long-lived form dialog — use overlay.modal",
      "Persistent side content — use container.card",
      "Full navigation menu — compose it from primitives"
    ],
    "implementation": "Further use cases:\n- Lightweight confirmation or hint attached to an action"
  },
  "definition": {
    "props": [
      {
        "name": "triggerLabel",
        "type": "string",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": true
      },
      {
        "name": "content",
        "type": "string",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": true
      },
      {
        "name": "placement",
        "type": "\"top\" | \"bottom\" | \"left\" | \"right\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "left",
            "right"
          ]
        },
        "bindable": false,
        "default": "bottom"
      }
    ],
    "defaultProps": {
      "placement": "bottom"
    },
    "canHaveChildren": false,
    "icon": "◲",
    "traits": [
      "modal-content"
    ]
  },
  "tags": [
    "tier:widget"
  ]
}
