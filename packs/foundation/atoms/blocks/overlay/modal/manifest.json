{
  "id": "overlay.modal",
  "kind": "block",
  "version": "1.0.0",
  "category": "overlay",
  "name": "modal",
  "state": "stable",
  "knowledge": {
    "purpose": "Centered dialog overlay that traps focus and obscures the page until dismissed",
    "useCases": [
      "Confirm a destructive action (delete, leave page)",
      "Quick create / edit form without leaving the page",
      "Image lightbox"
    ],
    "composesWith": [
      "form.form",
      "control.button",
      "text.heading",
      "text.text",
      "media.image",
      "layout.container",
      "text.alert"
    ],
    "antiPatterns": [
      "Long browsing flow — navigate to a dedicated surface",
      "Inline notification — use text.alert or a toast",
      "Persistent side panel — use overlay.drawer"
    ],
    "implementation": "Further use cases:\n- Onboarding step dialog"
  },
  "definition": {
    "props": [
      {
        "name": "title",
        "type": "string",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": true
      },
      {
        "name": "size",
        "type": "\"sm\" | \"md\" | \"lg\" | \"xl\" | \"full\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "xl",
            "full"
          ]
        },
        "bindable": false,
        "default": "md"
      },
      {
        "name": "closeOnOverlayClick",
        "type": "boolean",
        "jsonSchema": {
          "type": "boolean"
        },
        "bindable": false,
        "default": true
      },
      {
        "name": "closeOnEscape",
        "type": "boolean",
        "jsonSchema": {
          "type": "boolean"
        },
        "bindable": false,
        "default": true
      },
      {
        "name": "showCloseButton",
        "type": "boolean",
        "jsonSchema": {
          "type": "boolean"
        },
        "bindable": false,
        "default": true
      },
      {
        "name": "defaultOpen",
        "type": "boolean",
        "jsonSchema": {
          "type": "boolean",
          "description": "Whether it starts open on first render."
        },
        "bindable": false,
        "default": false
      },
      {
        "name": "triggerLabel",
        "type": "string",
        "jsonSchema": {
          "type": "string",
          "description": "Text of the button that opens the dialog. Falls back to the title; no button is drawn without either. With a bound open (the dialog is opened from elsewhere) only an explicit triggerLabel draws a button."
        },
        "bindable": true
      },
      {
        "name": "triggerVariant",
        "type": "\"primary\" | \"secondary\" | \"accent\" | \"outline\" | \"ghost\" | \"destructive\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "accent",
            "outline",
            "ghost",
            "destructive"
          ],
          "description": "Look of the built-in trigger button — the same variants as control.button (a secondary action beside a primary one)."
        },
        "bindable": false,
        "default": "primary"
      },
      {
        "name": "open",
        "type": "boolean",
        "jsonSchema": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Open state from the page: bind {{state.<key>}} (the same key as stateKey). A button elsewhere opens the dialog with {type:\"setState\", key, value:true}; writing false (e.g. after a form saves) closes it."
        },
        "bindable": true
      },
      {
        "name": "stateKey",
        "type": "string",
        "jsonSchema": {
          "type": "string",
          "description": "State key the modal writes true on open and false on close (its own trigger, close button, Escape, overlay click) — so {{state.<key>}} always matches what the visitor sees."
        },
        "bindable": false
      }
    ],
    "defaultProps": {
      "size": "md",
      "closeOnOverlayClick": true,
      "closeOnEscape": true,
      "showCloseButton": true,
      "triggerVariant": "primary"
    },
    "canHaveChildren": true,
    "icon": "◻",
    "traits": [],
    "allowedChildTraits": [
      "modal-content"
    ]
  },
  "tags": [
    "tier:widget"
  ]
}
