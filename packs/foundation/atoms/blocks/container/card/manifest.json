{
  "id": "container.card",
  "kind": "block",
  "version": "1.1.0",
  "category": "container",
  "name": "card",
  "state": "stable",
  "knowledge": {
    "purpose": "Bordered surface tile that visually groups related content with optional header / footer",
    "useCases": [
      "Dashboard KPI tile",
      "Item in a layout.grid (product, article, profile)",
      "Form section grouping"
    ],
    "composesWith": [
      "layout.grid",
      "layout.container",
      "media.image",
      "text.heading",
      "text.text",
      "control.button"
    ],
    "antiPatterns": [
      "Whole-page hero — use layout.section",
      "Modal dialog — a card is inline content, not an overlay",
      "Single value display — a heading or a large text with its label"
    ],
    "implementation": "Further use cases:\n- Settings group container"
  },
  "definition": {
    "props": [
      {
        "name": "padding",
        "type": "number",
        "jsonSchema": {
          "type": "number"
        },
        "bindable": false,
        "default": 16
      },
      {
        "name": "gap",
        "type": "number",
        "jsonSchema": {
          "type": "number"
        },
        "bindable": false,
        "default": 16
      },
      {
        "name": "backgroundColor",
        "type": "string",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": false
      },
      {
        "name": "borderRadius",
        "type": "number | string",
        "jsonSchema": {
          "type": [
            "number",
            "string"
          ]
        },
        "bindable": false
      },
      {
        "name": "borderWidth",
        "type": "number",
        "jsonSchema": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "bindable": false,
        "default": 1
      },
      {
        "name": "borderColor",
        "type": "string",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": false
      },
      {
        "name": "shadow",
        "type": "\"none\" | \"theme\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "none",
            "theme",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Card shadow. 'theme' (what a newly placed card gets) applies the theme's --pw-shadow-card decision (a tonal theme may set none); the enum steps are fixed choices. Left out, the card draws md."
        },
        "bindable": false,
        "default": "md"
      },
      {
        "name": "glass",
        "type": "\"none\" | \"sm\" | \"md\" | \"lg\"",
        "description": "Frosted-glass backdrop-blur. Themeable: the translucent fill is a color-mix of the card token, so it follows a theme recolour. Use over a gradient/image section for a glass panel; prefer this over a pinned rgba in block.style.",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        },
        "bindable": false,
        "default": "none"
      },
      {
        "name": "aspectRatio",
        "type": "number | string",
        "description": "CSS aspect-ratio for the card box, e.g. '16/9', '4/3', '1/1', '21/9', '3/2', or a number. Sets the ratio without forcing a fixed height — the card grows to its ratio against its column width.",
        "jsonSchema": {
          "type": [
            "number",
            "string"
          ]
        },
        "bindable": false
      },
      {
        "name": "align",
        "type": "\"start\" | \"center\" | \"end\" | \"stretch\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "bindable": false
      },
      {
        "name": "textAlign",
        "type": "\"left\" | \"center\" | \"right\"",
        "jsonSchema": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "bindable": false
      },
      {
        "name": "href",
        "type": "string",
        "description": "Makes the whole card one link: an app path (\"/menu\"), a URL or \"#anchor\". A click anywhere on the card opens it; the keyboard stops on it once; buttons and links placed inside still work on their own.",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": true
      },
      {
        "name": "hrefLabel",
        "type": "string",
        "description": "The card link's accessible name. Unset, the card's first heading names it.",
        "jsonSchema": {
          "type": "string"
        },
        "bindable": true
      }
    ],
    "defaultProps": {
      "padding": 16,
      "gap": 16,
      "borderWidth": 0,
      "shadow": "theme"
    },
    "canHaveChildren": true,
    "icon": "▭",
    "traits": []
  },
  "tags": [
    "tier:content"
  ]
}
