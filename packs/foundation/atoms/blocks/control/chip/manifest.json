{
  "id": "control.chip",
  "kind": "block",
  "version": "1.0.0",
  "category": "control",
  "name": "chip",
  "state": "stable",
  "knowledge": {
    "purpose": "A small labelled token the reader can act on: choose it, follow it, or dismiss it",
    "useCases": [
      "A filter currently narrowing a list, with a way to drop it",
      "A facet value with its result count",
      "A tag on an article or a product card",
      "A session track or topic marker"
    ],
    "composesWith": [
      "container.card",
      "data.repeater",
      "layout.container",
      "control.badge"
    ],
    "antiPatterns": [
      "A status that cannot be acted on — use control.badge",
      "Collecting new tokens from the reader — a chip displays or filters; it takes no typed input",
      "A page-level action — use control.button"
    ],
    "implementation": "With an href it renders as a link; without one, a button — never a div that only looks clickable. A selected chip is filled with the primary colour and its paired ink (and set in 600): a thin ring was measured too faint to tell the chosen filter from the rest. On a phone or touch screen an actionable chip is a real 44px-tall box. Tones mirror control.badge exactly, including its color-mix wash of the label's own token, so a chip stays legible inside a card where --pw-color-text is overridden. Pressing it emits one block:click; the runtime runs its action prop then, as for control.button. A removable chip is one control whose press — label or × — is the removal, named \"Remove <label>\" for a screen reader."
  },
