{
  "name": "icon-chip",
  "role": "part",
  "layoutOnly": true,
  "description": "Icon + label chip (quick-link tile).",
  "provenPattern": "A pure arrangement with no state or behaviour of its own, so it is a composition rather than a block (arrangement-only → template).",
  "knowledge": {
    "purpose": "Quick-link tile of icon and label",
    "useCases": [
      "Intranet quick-access grid",
      "Category shortcuts",
      "Tool list"
    ],
    "composesWith": [
      "layout.container"
    ],
    "antiPatterns": [
      "Leaving an icon without its label — an icon alone is not understood",
      "Picking an icon outside the icon canon",
      "More than eight chips — the grid becomes a scanning load"
    ]
  },
  "placeholders": {
    "{{ICON}}": "a valid name from the ICON_PATHS dictionary",
    "{{LABEL}}": "label"
  },
  "usesBlocks": [
    "container",
    "icon",
    "text"
  ],
  "snippet": {
    "id": "{{ID}}",
    "type": "container",
    "props": {
      "direction": "column",
      "gap": 8,
      "align": "center",
      "padding": 14,
      "borderRadius": "var(--pw-border-radius-xl)",
      "backgroundColor": "color-mix(in srgb, var(--pw-color-text) 5%, transparent)"
    },
    "children": [
      {
        "id": "{{ID}}-icon",
        "type": "icon",
        "props": {
          "name": "{{ICON}}",
          "size": 24,
          "color": "var(--pw-color-primary)"
        }
      },
      {
        "id": "{{ID}}-label",
        "type": "text",
        "props": {
          "content": "{{LABEL}}",
          "textAlign": "center"
        },
        "style": {
          "fontSize": "var(--pw-font-size-sm)"
        }
      }
    ]
  }
}
