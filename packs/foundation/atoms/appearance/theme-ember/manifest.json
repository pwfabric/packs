{
  "id": "theme-ember",
  "kind": "ui-appearance",
  "version": "1.0.0",
  "category": "ui",
  "name": "Ember",
  "state": "stable",
  "description": "Dark stage for a product: warm near-black ground, an amber primary, Montserrat headings over DM Sans body, large type and soft rounded corners.",
  "tags": [
    "theme",
    "appearance",
    "dark",
    "brand"
  ],
  "theme": {
    "colors": {
      "primary": "#f0a24b",
      "secondary": "#2a221d",
      "accent": "#33281f",
      "background": "#14110f",
      "card": "#1e1916",
      "text": "#f6eee6",
      "textMuted": "#bfb2a4",
      "border": "#3a302a",
      "error": "#f59a8f",
      "success": "#93d3a0",
      "warning": "#f3c46b",
      "info": "#9cc4ee",
      "textOnPrimary": "#1c1106"
    },
    "border": {
      "radius": "14px",
      "width": "1px",
      "style": "solid",
      "radiusLarge": "18px",
      "radiusSmall": "10px",
      "radiusXl": "22px",
      "radius2xl": "28px",
      "radiusFull": "9999px"
    },
    "typography": {
      "fontFamily": "\"DM Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "headingFontFamily": "Montserrat, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "monoFontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "baseFontSize": "17px",
      "headingWeight": "700",
      "headingLineHeight": "1.1",
      "letterSpacing": "-0.02em",
      "bodyLineHeight": "1.6",
      "bodyWeight": "400",
      "bodyLetterSpacing": "0em",
      "fontSizeXs": "13px",
      "fontSizeSm": "15px",
      "fontSizeLg": "19px",
      "fontSizeXl": "23px",
      "fontSize2xl": "30px",
      "fontSize3xl": "40px",
      "fontSize4xl": "54px"
    },
    "spacing": {
      "base": "1rem",
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.75rem",
      "xl": "2.75rem",
      "xxl": "4.5rem"
    },
    "shadows": {
      "card": "0 0 0 1px rgba(255,236,214,.05), 0 10px 30px rgba(0,0,0,.45)",
      "button": "0 6px 20px -6px rgba(240,162,75,.45)",
      "sm": "0 1px 2px rgba(0,0,0,.4)",
      "md": "0 6px 16px rgba(0,0,0,.45)",
      "lg": "0 14px 32px rgba(0,0,0,.5)",
      "xl": "0 24px 56px rgba(0,0,0,.55)"
    },
    "motion": {
      "durationFast": "150ms",
      "durationNormal": "200ms",
      "durationSlow": "300ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easingBounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "layout": {
      "gap": "0px",
      "padding": "0px",
      "containerMaxWidth": "1200px",
      "gridGap": "24px",
      "sectionPaddingY": "clamp(3.5rem, 8vw, 6rem)",
      "sectionPaddingX": "clamp(1rem, 4vw, 2rem)"
    },
    "focus": {
      "ringColor": "#f0a24b",
      "ringWidth": "2px",
      "ringOffset": "2px"
    },
    "zIndex": {
      "sticky": 150,
      "nav": 200,
      "dropdown": 300,
      "drawer": 400,
      "modal": 500,
      "toast": 540
    }
  },
  "darkTheme": {
    "colors": {
      "primary": "#f0a24b",
      "secondary": "#2a221d",
      "accent": "#33281f",
      "background": "#14110f",
      "card": "#1e1916",
      "text": "#f6eee6",
      "textMuted": "#bfb2a4",
      "border": "#3a302a",
      "error": "#f59a8f",
      "success": "#93d3a0",
      "warning": "#f3c46b",
      "info": "#9cc4ee",
      "textOnPrimary": "#1c1106"
    },
    "focus": {
      "ringColor": "#f0a24b"
    }
  },
  "knowledge": {
    "purpose": "A dark, warm look for a page that sells one thing: amber light on a near-black stage, big headings, rounded corners, glowing cards. Dark in both modes.",
    "useCases": [
      "A product launch or a pre-order waitlist",
      "An event, a festival or a night venue",
      "A portfolio or a studio that wants a dramatic first screen",
      "Pick it as a starting point and edit token values one by one"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "A tool people work in all day — wear midnight or slate",
      "A page that must look calm and official — wear zinc",
      "Pinning colours in block props — theme tokens already cascade",
      "Expecting two themes on one surface — a surface carries a single token set"
    ]
  }
}
