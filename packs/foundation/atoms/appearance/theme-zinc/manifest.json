{
  "id": "theme-zinc",
  "kind": "ui-appearance",
  "version": "2.0.0",
  "category": "ui",
  "name": "Zinc",
  "state": "stable",
  "description": "Neutral product and working tool: white ground, near-black ink and buttons, blue links, thin borders, system sans; a calm neutral dark mode for screens people work in all day.",
  "tags": [
    "theme",
    "appearance",
    "light"
  ],
  "knowledge": {
    "purpose": "A neutral look that gets out of the way: system sans, near-black primary, blue links, 8px corners, light shadows. It serves a shop, a service or a product page, and equally a tool, an admin screen or reference docs; its dark mode is a calm neutral one for screens people work in all day.",
    "useCases": [
      "A shop or a product site where photographs carry the colour",
      "A service or booking page that needs no brand palette yet",
      "A starting point when the brand is not known: edit primary and the fonts first",
      "Pick it as a starting point and edit token values one by one"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "Long reading — essays, a journal, a guide — wear paper",
      "A launch, an event or a brand that must be loud — wear ember",
      "Pinning colours in block props — theme tokens already cascade",
      "Expecting two themes on one surface — a surface carries a single token set"
    ]
  },
  "extends": "theme-base",
  "theme": {
    "colors": {
      "primary": "#18181b",
      "secondary": "#f4f4f5",
      "accent": "#f4f4f5",
      "text": "#09090b",
      "textMuted": "#5f5f69",
      "border": "#e4e4e7",
      "error": "#d92d20",
      "info": "#1d4ed8",
      "textOnPrimary": "#fafafa",
      "heading": "#09090b",
      "tableBorder": "#e4e4e7",
      "codeSurface": "#f4f4f5"
    },
    "typography": {
      "baseFontSize": "15px",
      "letterSpacing": "-0.01em",
      "bodyLineHeight": "1.5",
      "fontSizeSm": "13px",
      "fontSizeLg": "17px",
      "fontSizeXl": "19px",
      "fontSize2xl": "22px",
      "fontSize3xl": "26px",
      "fontSize4xl": "30px",
      "headingWeightH1": "700",
      "headingLineHeightH1": "1.15",
      "headingLineHeightH2": "1.25",
      "headingLineHeightH3": "1.3"
    },
    "spacing": {
      "md": "0.875rem",
      "lg": "1.25rem",
      "xl": "1.75rem",
      "xxl": "2.5rem"
    },
    "shadows": {
      "card": "none"
    },
    "motion": {
      "durationNormal": "200ms",
      "durationSlow": "300ms",
      "easingBounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "layout": {
      "gridGap": "24px",
      "sectionPaddingY": "clamp(2rem, 4vw, 3rem)"
    },
    "focus": {
      "ringColor": "#71717a"
    },
    "zIndex": {
      "sticky": 150,
      "nav": 200,
      "dropdown": 300,
      "drawer": 400,
      "modal": 500,
      "toast": 540
    },
    "blocks": {
      "prose": {
        "h2RuleWidth": "1px",
        "h2RuleGap": "0.35em"
      },
      "sidebar": {
        "currentSurface": "var(--pw-color-secondary)",
        "currentInk": "var(--pw-color-text)",
        "edgeWidth": "0px"
      },
      "table-of-contents": {
        "currentInk": "var(--pw-color-text)"
      }
    }
  },
  "darkTheme": {
    "colors": {
      "primary": "#f4f4f5",
      "secondary": "#27272a",
      "accent": "#27272a",
      "background": "#09090b",
      "card": "#18181b",
      "text": "#fafafa",
      "textMuted": "#a1a1aa",
      "border": "#2e2e33",
      "error": "#f87171",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "info": "#60a5fa",
      "textOnPrimary": "#18181b",
      "heading": "#fafafa",
      "link": "#93b2ff",
      "tableBorder": "#2e2e33",
      "codeSurface": "#1f1f23"
    },
    "focus": {
      "ringColor": "#a1a1aa"
    }
  }
}
