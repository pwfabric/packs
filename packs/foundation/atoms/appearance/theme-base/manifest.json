  "knowledge": {
    "purpose": "The plain base of the foundation themes: neutral grey and one blue, nothing more. Zinc, paper and ember extend it and write only what differs; wear it on its own to judge a page by its structure, not its look, or as the start of a theme of your own (\"extends\": \"theme-base\").",
    "useCases": [
      "A starting point for a theme of your own: extend it and change what you need",
      "Judging a layout without a theme’s character",
      "Tests and demos that need one predictable look"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "A finished product look — wear zinc, paper or ember",
      "Pinning colours in block props — theme tokens already cascade",
      "Expecting two themes on one surface — a surface carries a single token set"
    ]
  }
