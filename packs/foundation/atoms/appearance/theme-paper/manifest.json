{
  "id": "theme-paper",
  "kind": "ui-appearance",
  "version": "2.0.0",
  "category": "ui",
  "name": "Paper",
  "state": "stable",
  "description": "Calm reading: strong cream ground, ink-navy primary, burgundy links, light Newsreader headings over Source Serif body at 18px with a long line, square corners, no shadows, a narrow column.",
  "tags": [
    "theme",
    "appearance",
    "light",
    "editorial"
  ],
  "knowledge": {
    "purpose": "A look for pages people read through and places people visit: serif voice, a generous 18px body with a long line height, warm paper and rust links, near-square corners and no shadows, so type carries the page. It serves a magazine, a journal or a long guide, and a café, a booking page or a local service.",
    "useCases": [
      "A magazine, a journal or a blog",
      "Documentation or long guides read top to bottom",
      "A studio or practice whose site is its writing and its pictures",
      "Pick it as a starting point and edit token values one by one"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "A dense data screen or a tool people work in all day — wear zinc",
      "A launch, an event or a brand that must be loud — wear ember",
      "Pinning colours in block props — theme tokens already cascade",
      "Expecting two themes on one surface — a surface carries a single token set"
    ]
  },
  "extends": "theme-base",
  "theme": {
    "colors": {
      "primary": "#1f3354",
      "secondary": "#ede6d8",
      "accent": "#efe3cc",
      "background": "#f5efe3",
      "card": "#faf6ee",
      "text": "#1d1a16",
      "textMuted": "#5a5248",
      "border": "#ddd3c1",
      "error": "#a8261b",
      "success": "#2f6b3a",
      "warning": "#8a5a00",
      "info": "#1f4f8a",
      "textOnPrimary": "#ffffff",
      "heading": "#1d1a16",
      "link": "#8b1e3f",
      "tableBorder": "#ddd3c1",
      "codeSurface": "#ede5d5"
    },
    "border": {
      "radius": "0px",
      "radiusLarge": "0px",
      "radiusSmall": "0px",
      "radiusXl": "0px",
      "radius2xl": "0px",
      "radiusFull": "0px"
    },
    "typography": {
      "fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
      "headingFontFamily": "Newsreader, Georgia, \"Times New Roman\", serif",
      "baseFontSize": "18px",
      "headingWeight": "500",
      "headingLineHeight": "1.15",
      "bodyLineHeight": "1.75",
      "fontSizeXs": "13px",
      "fontSizeSm": "15px",
      "fontSizeLg": "20px",
      "fontSizeXl": "22px",
      "fontSize2xl": "26px",
      "fontSize3xl": "32px",
      "fontSize4xl": "40px",
      "headingLineHeightH1": "1.1",
      "headingLineHeightH2": "1.2",
      "headingLineHeightH3": "1.3"
    },
    "spacing": {
      "xs": "0.3rem",
      "sm": "0.6rem",
      "md": "1.1rem",
      "lg": "1.75rem",
      "xl": "2.5rem",
      "xxl": "4rem"
    },
    "shadows": {
      "card": "none",
      "sm": "none",
      "md": "0 2px 8px rgba(40,30,15,.08)",
      "lg": "0 8px 20px rgba(40,30,15,.10)",
      "xl": "0 16px 36px rgba(40,30,15,.12)"
    },
    "motion": {
      "durationNormal": "200ms",
      "durationSlow": "300ms",
      "easingBounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "layout": {
      "containerMaxWidth": "1080px",
      "gridGap": "28px",
      "sectionPaddingY": "clamp(4rem, 7vw, 6rem)",
      "sectionPaddingX": "clamp(1rem, 3vw, 2rem)"
    },
    "focus": {
      "ringColor": "#3d6aa8"
    },
    "zIndex": {
      "sticky": 150,
      "nav": 200,
      "dropdown": 300,
      "drawer": 400,
      "modal": 500,
      "toast": 540
    },
    "blocks": {
      "prose": {
        "h1SpaceBelow": "0.6em",
        "h2SpaceAbove": "2.2em",
        "h2SpaceBelow": "0.5em",
        "paragraphSpaceBelow": "1.1em",
        "listItemSpaceBelow": "0.4em",
        "inlineCodeFontSize": "0.88em",
        "tableCellPaddingBlock": "0.55em"
      }
    }
  },
  "darkTheme": {
    "colors": {
      "primary": "#a9c1e8",
      "secondary": "#2a2620",
      "accent": "#2f2a22",
      "background": "#161411",
      "card": "#1e1b17",
      "text": "#efe8dc",
      "textMuted": "#b4aa9a",
      "border": "#3a342b",
      "error": "#f0a093",
      "success": "#9fd1a5",
      "warning": "#e8c27a",
      "info": "#9cc0ee",
      "textOnPrimary": "#121b2b",
      "heading": "#efe8dc",
      "link": "#e6a3b6",
      "tableBorder": "#3a342b",
      "codeSurface": "#24201a"
    },
    "focus": {
      "ringColor": "#a9c1e8"
    }
  }
}
