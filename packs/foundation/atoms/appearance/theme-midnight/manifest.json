  "knowledge": {
    "purpose": "A dark look for screens people work in: IBM Plex Sans at 15px, tight line height, small corners, a blue primary that reads on navy. Dark in both modes.",
    "useCases": [
      "A dashboard, a metrics page or an operations console",
      "An internal tool used all day on a large screen",
      "A developer-facing product whose audience prefers dark",
      "Pick it as a starting point and edit token values one by one"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "A marketing page meant to warm a visitor up — wear ember",
      "Long reading — the dense rhythm is for scanning, not for articles",
      "Pinning colours in block props — theme tokens already cascade",
      "Expecting two themes on one surface — a surface carries a single token set"
    ]
  }
